# ==============================================================================
# PGI DENTAL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for production or local overrides
# ==============================================================================

# Database Connection (MySQL 8.0 in Production, SQLite supported in Local Dev)
DATABASE_URL=mysql+pymysql://dental_user:dental_password@127.0.0.1:3306/dental_db
# For local SQLite dev without MySQL: sqlite:///./dental.db

# Security & Cryptography (Generate strong random 64-char keys)
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_REFRESH_SECRET_KEY=replace_with_another_cryptographically_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Environment (production, staging, development)
ENVIRONMENT=development
DEBUG=true

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Encrypted File Vault Storage (local_encrypted or s3)
STORAGE_TYPE=local_encrypted
# 64-char hex or base64 32-byte AES-256 key (leave empty in dev to auto-generate vault key)
FILE_ENCRYPTION_KEY=
MAX_UPLOAD_SIZE_MB=25
MAX_CBCT_SIZE_MB=500

# Optional S3 / MinIO Settings (when STORAGE_TYPE=s3)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PGI Dental Branch Details & PDF Letterhead Branding
CLINIC_NAME=PGI Dental Branch — Oral Health Sciences Centre
CLINIC_ADDRESS=Oral Health Sciences Centre, PGIMER, Sector 12, Chandigarh 160012
CLINIC_PHONE=+91 172 275 6831 / +91 172 274 7585
CLINIC_EMAIL=dental@pgimer.edu.in
CLINIC_WEBSITE=pgimer.edu.in
CLINIC_REG_NO=PGIMER-OHSC-CHD | DCI-INST-012

# SMS & Email Notifications
SMS_SENDER_ID=PGIDNT
SMS_PROVIDER=sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=dental@pgimer.edu.in

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
